{
  "name": "swaglabs-playwright-cucumber",
  "version": "1.0.0",
  "description": "Industry-level Playwright + TypeScript + Cucumber (BDD) framework using Page Object Model for https://www.saucedemo.com",
  "scripts": {
    "postinstall": "playwright install --with-deps chromium || playwright install chromium",
    "test": "cucumber-js",
    "test:smoke": "cucumber-js --tags \"@smoke\"",
    "test:regression": "cucumber-js --tags \"@regression\"",
    "test:negative": "cucumber-js --tags \"@negative\"",
    "test:parallel": "cucumber-js --profile parallel",
    "test:headed": "HEADLESS=false cucumber-js",
    "test:firefox": "BROWSER=firefox cucumber-js",
    "test:webkit": "BROWSER=webkit cucumber-js",
    "test:dry": "cucumber-js --dry-run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rimraf reports && mkdir reports"
  },
  "keywords": ["playwright", "cucumber", "typescript", "pom", "bdd", "saucedemo"],
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.14.0",
    "dotenv": "^16.4.5",
    "@faker-js/faker": "^8.4.1",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
